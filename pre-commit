#!/bin/bash
# =============================================================================
# Git pre-commit hook: автоупаковка модулей обычных форм в Form.bin
#
# При коммите:
# 1. Находит изменённые Module.bsl, лежащие рядом с Form.bin
# 2. Упаковывает модуль обратно в Form.bin (через v8unpack)
# 3. Добавляет обновлённый Form.bin в коммит
#
# Требования: pip install v8unpack
# =============================================================================

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
TOOLS_DIR="${REPO_ROOT}/.1c-tools"
PACK_SCRIPT="${TOOLS_DIR}/pack_form_modules.py"
RUN_PYTHON="${TOOLS_DIR}/run-python"
cd "$REPO_ROOT"

# NUL delimiters preserve Cyrillic paths and spaces even with core.quotePath=true.
MODULES=()
while IFS= read -r -d '' file; do
    case "$file" in
        */[Mm][Oo][Dd][Uu][Ll][Ee].[Bb][Ss][Ll])
            if [ -f "$(dirname "$file")/Form.bin" ]; then
                MODULES+=("$file")
            fi
            ;;
    esac
done < <(git diff --cached --name-only -z --diff-filter=ACM)
[ "${#MODULES[@]}" -gt 0 ] || exit 0

[ -f "$PACK_SCRIPT" ] || { echo "[pre-commit] Missing $PACK_SCRIPT" >&2; exit 1; }
[ -f "$RUN_PYTHON" ] || { echo "[pre-commit] Missing $RUN_PYTHON" >&2; exit 1; }
# Fail before any binary changes if interpreter selection or imports are invalid.
bash "$RUN_PYTHON" -c 'import v8unpack'

# Packing reads working-tree files, so do not include unstaged changes accidentally.
for file in "${MODULES[@]}"; do
    if ! git diff --quiet -- "$file" "$(dirname "$file")/Form.bin"; then
        echo "[pre-commit] Stage all changes to Module.bsl and Form.bin first: $file" >&2
        exit 1
    fi
done

echo "[pre-commit] Упаковка модулей обычных форм..."

ERRORS=0
PACKED=0

for BSL_FILE in "${MODULES[@]}"; do
    BSL_DIR=$(dirname "$BSL_FILE")
    BIN_FILE="${BSL_DIR}/Form.bin"
    FULL_BIN_PATH="${REPO_ROOT}/${BIN_FILE}"
    FULL_BSL_DIR="${REPO_ROOT}/${BSL_DIR}"

    # Упаковываем только если рядом есть Form.bin (= обычная форма)
    if [ -f "$FULL_BIN_PATH" ]; then
        echo "[pre-commit]   ${BSL_FILE}"

        # Вызываем pack для директории формы; статус сохраняем ДО фильтрации
        # вывода (проверка PIPESTATUS после if затиралась телом ветки)
        PACK_STATUS=0
        PACK_OUTPUT=$(bash "$RUN_PYTHON" "$PACK_SCRIPT" "$FULL_BSL_DIR" --no-backup 2>&1) || PACK_STATUS=$?
        echo "$PACK_OUTPUT" | grep -v "^INFO:" || true

        if [ $PACK_STATUS -ne 0 ]; then
            echo "[pre-commit]   ✗ ОШИБКА упаковки"
            ERRORS=1
        else
            # Добавляем обновлённый Form.bin в коммит
            git add -- "$BIN_FILE"
            echo "[pre-commit]   ✓ → ${BIN_FILE}"
            PACKED=$((PACKED + 1))
        fi
    fi
done

if [ $ERRORS -ne 0 ]; then
    echo "[pre-commit] Коммит отменён из-за ошибок упаковки."
    exit 1
fi

if [ $PACKED -gt 0 ]; then
    echo "[pre-commit] Упаковано форм: ${PACKED}"
fi
